# ─────────────────────────────────────────────────────────────────────
#  PyDebug Backend — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ── Google Gemini ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

# ── Repair loop ────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3

# ── Execution sandbox ──────────────────────────────────────────────────
EXECUTION_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000
SANDBOX_IMAGE=python:3.12-slim

# ── Project storage ────────────────────────────────────────────────────
WORKSPACES_DIR=workspaces
MAX_FILE_SIZE_BYTES=1000000
MAX_FILES_PER_PROJECT=20

# ── API ────────────────────────────────────────────────────────────────
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000" , "https://pydebug.jc7.in"]

# ── Prompt strategy: basic | structured ───────────────────────────────
PROMPT_STRATEGY=structured

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
